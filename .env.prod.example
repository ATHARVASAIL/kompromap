# Copy this to .env in the repo root before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# CHANGE THE DEFAULTS BELOW — these are placeholders, not safe to deploy as-is.

# --- Database ---
POSTGRES_USER=kompromap
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=kompromap

# --- Backend ---
# STRONGLY RECOMMENDED for any deployment reachable off your own machine.
# Without it, every endpoint is fully open — anyone who finds the URL can
# read, modify and delete all your engagement data. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank ONLY for localhost-only use.
API_KEY=


# Comma-separated list of origins allowed to call the API. Set this to your
# actual frontend URL(s) in production — the default below only works for
# local testing of the prod compose file itself.
CORS_ORIGINS=http://localhost

# Number of uvicorn worker processes.
UVICORN_WORKERS=2

# Optional — only needed for LLM-generated attack-chain narratives
# (falls back to a template narrative if unset, see README).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend ---
# Leave empty if frontend + backend are deployed together via this compose
# file (nginx reverse-proxies /api to the backend automatically). Set this
# to the backend's public URL only if you're hosting the frontend
# separately from the backend.
VITE_API_BASE_URL=

# Port the frontend's nginx listens on, on the host.
FRONTEND_PORT=80
