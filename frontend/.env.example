# Leave empty for same-origin deployments (docker-compose, or any reverse
# proxy serving frontend + backend under one domain). Set to the backend's
# full URL if the frontend is hosted separately (e.g. a static host +
# a separately hosted API): VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Optional API key, must match the backend's API_KEY setting.
# Leave blank for local single-user use (no auth).
# NOTE: this is inlined into the built bundle and visible to anyone who
# loads the page — it gates anonymous access to a self-hosted instance,
# it is not a per-user secret.
VITE_API_KEY=
