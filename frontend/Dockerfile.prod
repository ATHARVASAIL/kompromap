# Multi-stage build: compile the Vite app, then serve the static output
# with nginx. The dev Dockerfile (running the Vite dev server) is kept
# separate for docker-compose.yml's local-dev workflow — this one is what
# docker-compose.prod.yml and the CD workflow build.

FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Both are read at build time (Vite inlines env vars into the bundle).
# VITE_API_KEY is therefore visible in the shipped JS — it gates anonymous
# access to a self-hosted instance, it is not a per-user secret. See
# backend/app/core/security.py for the threat model.
ARG VITE_API_BASE_URL=""
ARG VITE_API_KEY=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_KEY=${VITE_API_KEY}
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
